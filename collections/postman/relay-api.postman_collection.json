            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pricing"
              ]
            },
            "description": "Credit unit price (pricing:read)."
          }
        },
        {
          "name": "Estimate a route",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pricing/estimate?pickup_lat=6.3703&pickup_lng=2.3912&delivery_lat=6.3654&delivery_lng=2.4183&weight_kg=2.5&assignment_mode=own_fleet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pricing",
                "estimate"
              ],
              "query": [
                {
                  "key": "pickup_lat",
                  "value": "6.3703"
                },
                {
                  "key": "pickup_lng",
                  "value": "2.3912"
                },
                {
                  "key": "delivery_lat",
                  "value": "6.3654"
                },
                {
                  "key": "delivery_lng",
                  "value": "2.4183"
                },
                {
                  "key": "weight_kg",
                  "value": "2.5"
                },
                {
                  "key": "assignment_mode",
                  "value": "own_fleet"
                }
              ]
            },
            "description": "Pickup and delivery points are required for agency keys."
          }
        },
        {
          "name": "Create a package",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "ORD-1001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/packages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "packages"
              ]
            },
            "description": "Idempotency-Key and external_order_id make retries safe.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_order_id\": \"ORD-1001\",\n  \"client_name\": \"Jean Dupont\",\n  \"client_phone\": \"+22991234567\",\n  \"client_address\": \"Rue des Fleurs, Cotonou\",\n  \"delivery_address\": \"Marché Dantokpa, Cotonou\",\n  \"pickup_latitude\": 6.3703,\n  \"pickup_longitude\": 2.3912,\n  \"delivery_latitude\": 6.3654,\n  \"delivery_longitude\": 2.4183,\n  \"weight_kg\": 2.5,\n  \"assignment_mode\": \"own_fleet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
