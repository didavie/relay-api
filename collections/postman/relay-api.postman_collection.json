    {
      "name": "Sandbox only",
      "item": [
        {
          "name": "Force a status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sandbox/packages/{{trackingCode}}/simulate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sandbox",
                "packages",
                "{{trackingCode}}",
                "simulate"
              ]
            },
            "description": "Sandbox only. Moves the delivery forward and sends the matching webhook.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"delivered\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Pause auto-advance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sandbox/packages/{{trackingCode}}/simulate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sandbox",
                "packages",
                "{{trackingCode}}",
                "simulate"
              ]
            },
            "description": "Sandbox only. false pauses the automatic steps, true resumes them.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auto_advance\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send a test webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sandbox/webhook/test",
              "host": [
